{
    "builds": [
        {
            "src": "backend/main.py",
            "use": "@vercel/python"
        }
    ],
    "routes": [
        {
            "src": "/",
            "dest": "/frontend/index.html"
        },
        {
            "src": "/(.*\\.(css|js|html|png|jpg|jpeg))",
            "dest": "/frontend/$1"
        },
        {
            "src": "/(.*)",
            "dest": "backend/main.py"
        }
    ]
}